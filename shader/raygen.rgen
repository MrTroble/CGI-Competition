#version 460
#extension GL_EXT_ray_tracing : require

#include "../main/Shared.hpp"

layout(set=1, binding=0) uniform accelerationStructureEXT topLevelAS;
layout(set=1, binding=1) uniform CAMERA {
	mat4 _u1;
	mat4 _u2;
    mat4 _u3;
    mat4 viewInverse;
    mat4 projInverse;
    vec4 windowInfo;
    uint frameCount;
} camera;

layout(set=0,binding=0, rgba8) uniform image2D image;

layout(location = 0) rayPayloadEXT Payload payload;

layout(location = 1) rayPayloadEXT ShadowPayload shadowPayload;

layout(location = 2) rayPayloadEXT vec3 lightPayload;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size  = ivec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    uv = uv * 2.0 - 1.0;

	vec4 origin = camera.viewInverse * vec4(0,0,0,1);
	vec4 target = camera.projInverse * vec4(uv.x, uv.y, 1, 1) ;
	vec4 direction = camera.viewInverse * vec4(normalize(target.xyz), 0);

	float tmin = 0.001;
	float tmax = 10000.0;

    payload.normal = vec3(0.0);
    payload.spectrum = vec3(0.0);
    payload.contribution = vec3(1.0f);
    rngInit(payload.random, uint(pixel.x), uint(pixel.y), camera.frameCount, 11700);
    
    for(uint i = 0; i < 5; i++) {
        traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, origin.xyz, tmin, direction.xyz, tmax, 0);
        origin = vec4(payload.pos, 1);
        direction = vec4(payload.dir, 1);
        if(payload.miss) break;
    }
    float translation = float(camera.frameCount - 1) / float(camera.frameCount);
    if(camera.frameCount <= 1) translation = 0;
    vec4 current = imageLoad(image, pixel) * translation;
    // Component change for copy accumulate
    vec3 colorC = vec3(payload.spectrum.z, payload.spectrum.y, payload.spectrum.x) / float(camera.frameCount);
    imageStore(image, pixel, vec4(current.xyz + colorC, 1.0));
}